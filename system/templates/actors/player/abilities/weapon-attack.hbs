<a
	class="rollable"
	data-action="item-attack"
	data-attack-type="{{attackType}}"
	data-item-id="{{this.itemUuid}}"
>
	<i class="fa-solid fa-dice-d20"></i>
	<b class="item-name">{{this.item.name}}</b>
	{{this.mainRoll.bonus}}
	({{this.damageRoll.formula}})
</a>
<span class="item-subtext">
	{{formatSubtext this.item.system.subtext attackType}}
</span>
