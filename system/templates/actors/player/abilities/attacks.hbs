<div class="SD-box">
	<div class="header">
		<label>{{localize 'SHADOWDARK.sheet.player.melee_attacks'}}</label>
		<span></span>
	</div>
	<div class="content">
		{{#each attacks.melee}}
			<div class="attack item" data-item-id="{{this.item._id}}" data-item-uuid="{{this.itemUuid}}">
				{{> actors/player/abilities/weapon-attack attackType="melee"}}
			</div>
		{{/each}}
	</div>
</div>

<div class="SD-box">
	<div class="header">
		<label>{{localize 'SHADOWDARK.sheet.player.ranged_attacks'}}</label>
		<span></span>
	</div>
	<div class="content">
		{{#each attacks.ranged}}
			<div class="attack item" data-item-id="{{this.item._id}}" data-item-uuid="{{this.itemUuid}}">
				{{> actors/player/abilities/weapon-attack attackType="ranged"}}
			</div>
		{{/each}}
	</div>
</div>
